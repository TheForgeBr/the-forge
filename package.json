{
  "name": "the-forge",
  "private": true,
  "type": "module",
  "description": "The Forge BR: site pessoal de Rhuan Marques",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --outDir build/client",
    "typegen": "react-router typegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run verificar:tokens && npm run verificar:logo && npm run verificar:cartoes && npm run verificar:banner && npm run build && npm run verificar:rotas && npm run verificar:fontes && npm run orcamento && npm run verificar:privacidade",
    "test": "vitest run",
    "verificar:rotas": "node scripts/verificar-rotas.mjs",
    "tokens": "node scripts/gerar-tokens.mjs",
    "verificar:tokens": "node scripts/gerar-tokens.mjs --verificar",
    "logo": "node scripts/gerar-logo.mjs",
    "verificar:logo": "node scripts/gerar-logo.mjs --verificar",
    "verificar:fontes": "node scripts/verificar-fontes.mjs",
    "orcamento": "node scripts/orcamento.mjs",
    "verificar:privacidade": "node scripts/privacidade.mjs",
    "imagens": "node scripts/gerar-imagens.mjs",
    "cartoes": "node scripts/gerar-cartoes.mjs",
    "verificar:cartoes": "node scripts/gerar-cartoes.mjs --verificar",
    "banner": "node scripts/gerar-banner.mjs",
    "verificar:banner": "node scripts/gerar-banner.mjs --verificar"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@react-router/node": "^7.18.4",
    "isbot": "^5.2.2",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.18.4",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
